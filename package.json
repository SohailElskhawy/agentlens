{
  "name": "agentlens",
  "version": "0.1.0",
  "description": "Local-first, read-only usage and workflow optimizer for AI coding agents",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.18" },
  "bin": { "agentlens": "bin/agentlens" },
  "keywords": [
    "ai",
    "agent",
    "tokenomics",
    "claude-code",
    "codex",
    "antigravity",
    "opencode",
    "mcp",
    "workflow-optimizer",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SohailElskhawy/agentlens.git"
  },
  "files": [
    "bin",
    "src",
    "web",
    "assets",
    "catalog.json",
    "catalog.yaml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "start": "node --no-warnings=ExperimentalWarning src/cli.ts serve",
    "status": "node --no-warnings=ExperimentalWarning src/cli.ts status",
    "audit": "node --no-warnings=ExperimentalWarning src/cli.ts audit",
    "report": "node --no-warnings=ExperimentalWarning src/cli.ts report",
    "track": "node --no-warnings=ExperimentalWarning src/cli.ts track",
    "catalog": "node --no-warnings=ExperimentalWarning src/cli.ts catalog",
    "update-prices": "node scripts/update-prices.ts"
  },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "24.10.1" }
}
